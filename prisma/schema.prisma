// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Penduduk {
  id           String   @id @default(uuid())
  nik          String   @unique
  nama         String
  jenisKelamin String   // "Laki-laki" | "Perempuan"
  tanggalLahir DateTime
  pekerjaan    String
  alamat       String
  jorong       String   // e.g. "Jorong Koto", "Jorong Baru", etc.
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Berita {
  id        String   @id @default(uuid())
  judul     String
  ringkasan String
  konten    String   @db.Text
  kategori  String   
  gambar    String?  
  tanggal   String   
  readTime  String?  
  tagColor  String?  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Anggaran {
  id        String   @id @default(uuid())
  tahun     Int
  tipe      String   // "PENDAPATAN" | "BELANJA"
  kategori  String   // e.g. "Dana Desa", "Pendidikan", "Infrastruktur"
  rincian   String
  jumlah    Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Umkm {
  id        String   @id @default(uuid())
  nama      String
  pemilik   String
  deskripsi String   @db.Text
  harga     String
  kategori  String
  whatsapp  String
  gambar    String?
  gradient  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}